# ---------------------------------------------------------------------------
# ITop Med environment. Copy to .env for local development.
# NEVER commit real secrets. Production secrets come from the secret manager.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# Local embedded PostgreSQL (npm run db:start). Three roles, see ARCHITECTURE.md
DEV_PG_PORT=54329
DEV_PG_SUPERUSER_PASSWORD=dev-superuser-change-me
DEV_PG_OWNER_PASSWORD=dev-owner-change-me
DEV_PG_APP_PASSWORD=dev-app-change-me
DEV_PG_PLATFORM_PASSWORD=dev-platform-change-me
DEV_PG_PORTAL_PASSWORD=dev-portal-change-me

# Schema owner — migrations only.
MIGRATION_DATABASE_URL=postgresql://itopmed_owner:dev-owner-change-me@localhost:54329/itopmed
# Clinic application role — RLS enforced, tenant context required.
DATABASE_URL=postgresql://itopmed_app:dev-app-change-me@localhost:54329/itopmed
# Platform administration role — no grants on clinical tables.
PLATFORM_DATABASE_URL=postgresql://itopmed_platform:dev-platform-change-me@localhost:54329/itopmed
# Patient portal role — sees only the signed-in patient's own released data.
PORTAL_DATABASE_URL=postgresql://itopmed_portal:dev-portal-change-me@localhost:54329/itopmed

# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Separate 32-byte key used to pseudonymise IPs in audit logs.
AUDIT_HMAC_KEY=
# Separate 32-byte key (base64) for encrypted backups. Store it in the secret manager, not with the backups.
BACKUP_ENCRYPTION_KEY=

# Email: "dev-mailbox" writes messages to ./.dev-mailbox (SIMULATED, dev only) | "smtp"
EMAIL_TRANSPORT=dev-mailbox
SMTP_URL=

# SMS: "none" (off) | "dev-outbox" (SIMULATED, dev only: writes to ./.dev-mailbox/sms). No real SMS provider is integrated yet.
SMS_TRANSPORT=dev-outbox
EMAIL_FROM="ITop Med <no-reply@itopmed.example>"

# Log In with Telegram (OpenID Connect, https://core.telegram.org/bots/telegram-login).
# @BotFather > your bot > Login Widget: register ${APP_URL}/auth/telegram/callback as an
# Allowed URL and copy the Client ID and Client Secret here. Empty = no Telegram button
# (sign-in with login + password only). Needs a public HTTPS domain: Telegram refuses
# LAN addresses, so a clinic's local installation leaves these empty.
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=

# Telegram (each clinic connects its own bot in Integrations): "api" = official Bot API,
# "dev-outbox" = SIMULATED (files in .dev-mailbox/telegram), "none" = off.
# Default: api in production (npm run local), dev-outbox otherwise.
TELEGRAM_TRANSPORT=

# CENTRAL ITop Med bot from @BotFather (Login Widget, Mini App, /start). Empty = off.
# After setting it on a public HTTPS server: npm run telegram:setup
TELEGRAM_BOT_TOKEN=
