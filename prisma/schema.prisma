// ITop Med — relational schema.
//
// Conventions (see docs/DATABASE-DESIGN.md):
// * UUIDv7 primary keys generated by the application.
// * Every clinic-owned table carries `tenantId` and is protected by PostgreSQL
//   Row-Level Security (policies live in the SQL migrations, not here).
// * Clinical tables are added in later migrations and are NEVER granted to the
//   platform database role.
// * Locales are stored as BCP-47 strings constrained by CHECK constraints:
//   'uz-Latn' | 'uz-Cyrl' | 'ru' | 'en'.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Platform (ITop Med staff) ─────────────────────

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT
  BILLING
  READ_ONLY
}

enum AccountStatus {
  INVITED
  ACTIVE
  DISABLED
}

model PlatformUser {
  id               String        @id @db.Uuid
  email            String        @unique
  fullName         String
  passwordHash     String?
  role             PlatformRole
  status           AccountStatus @default(INVITED)
  locale           String        @default("uz-Latn")
  /// AES-256-GCM encrypted TOTP secret (see src/server/security/crypto.ts)
  mfaSecretEnc     String?
  mfaEnabledAt     DateTime?
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions        PlatformSession[]
  invitationsSent PlatformInvitation[] @relation("PlatformInviter")
  tenantsCreated  Tenant[]
  supportGrants   SupportAccessGrant[]
}

model PlatformSession {
  /// SHA-256 (hex) of the session token. The raw token only exists in the cookie.
  id             String    @id
  platformUserId String    @db.Uuid
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  lastSeenAt     DateTime  @default(now())
  mfaVerifiedAt  DateTime?
  revokedAt      DateTime?
  ipHash         String?
  userAgent      String?

  user PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
}

model PlatformInvitation {
  id          String           @id @db.Uuid
  email       String
  fullName    String
  role        PlatformRole
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  invitedById String           @db.Uuid
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())

  invitedBy PlatformUser @relation("PlatformInviter", fields: [invitedById], references: [id])

  @@index([email])
}

// ───────────────────────────── Tenancy & subscriptions ───────────────────────

enum TenantStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Tenant {
  id               String       @id @db.Uuid
  slug             String       @unique
  name             String
  legalName        String?
  /// Uzbekistan taxpayer identification number (STIR/INN) of the legal entity.
  taxId            String?
  status           TenantStatus @default(PROVISIONING)
  defaultLocale    String       @default("uz-Latn")
  timezone         String       @default("Asia/Tashkent")
  currency         String       @default("UZS")
  countryCode      String       @default("UZ")
  /// Where this tenant's data must be hosted. Changing it requires a documented legal assessment.
  dataResidency    String       @default("UZ")
  contactEmail     String?
  contactPhone     String?
  address          String?
  createdById      String?      @db.Uuid
  activatedAt      DateTime?
  suspendedAt      DateTime?
  suspensionReason String?
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  createdBy          PlatformUser?        @relation(fields: [createdById], references: [id])
  branches           Branch[]
  departments        Department[]
  memberships        Membership[]
  roles              Role[]
  invitations        Invitation[]
  modules            TenantModule[]
  subscription       Subscription?
  supportGrants      SupportAccessGrant[]
  rooms              Room[]
  services           Service[]
  doctorProfiles     DoctorProfile[]
  workSchedules      WorkSchedule[]
  scheduleExceptions ScheduleException[]
  doctorServices     DoctorService[]

  @@index([status])
}

model Branch {
  id         String    @id @db.Uuid
  tenantId   String    @db.Uuid
  name       String
  code       String?
  address    String?
  phone      String?
  isMain     Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departments Department[]
  members     MembershipBranch[]
  rooms       Room[]
  schedules   WorkSchedule[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Department {
  id         String    @id @db.Uuid
  tenantId   String    @db.Uuid
  branchId   String?   @db.Uuid
  name       String
  specialty  String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch   Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  services Service[]
  doctors  DoctorProfile[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
}

model Plan {
  id                String   @id @db.Uuid
  code              String   @unique
  /// Localised display names: { "uz-Latn": "...", "uz-Cyrl": "...", "ru": "...", "en": "..." }
  name              Json
  priceMonthlyMinor BigInt   @default(0)
  currency          String   @default("UZS")
  maxUsers          Int?
  maxBranches       Int?
  maxStorageMb      Int?
  /// Module keys included in the plan (see src/server/modules/catalog.ts)
  modules           String[]
  trialDays         Int      @default(14)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model Subscription {
  id                 String             @id @db.Uuid
  tenantId           String             @unique @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id])
}

model TenantModule {
  tenantId    String   @db.Uuid
  moduleKey   String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, moduleKey])
}

// ───────────────────────────── Clinic identity & access ──────────────────────

model User {
  id               String        @id @db.Uuid
  email            String        @unique
  phone            String?
  fullName         String
  passwordHash     String?
  status           AccountStatus @default(INVITED)
  /// Personal UI language; null = follow the clinic default.
  locale           String?
  mfaSecretEnc     String?
  mfaEnabledAt     DateTime?
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions       Session[]
  memberships    Membership[]
  passwordResets PasswordReset[]
}

/// Single-use password reset. Only the SHA-256 of the emailed token is stored.
model PasswordReset {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipHash    String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  /// SHA-256 (hex) of the session token.
  id             String    @id
  userId         String    @db.Uuid
  /// Clinic currently selected in this session (switchable among memberships).
  activeTenantId String?   @db.Uuid
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  lastSeenAt     DateTime  @default(now())
  mfaVerifiedAt  DateTime?
  revokedAt      DateTime?
  ipHash         String?
  userAgent      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

model Membership {
  id          String           @id @db.Uuid
  tenantId    String           @db.Uuid
  userId      String           @db.Uuid
  status      MembershipStatus @default(INVITED)
  jobTitle    String?
  /// When false the member is restricted to the branches in MembershipBranch.
  allBranches Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles         MembershipRole[]
  branches      MembershipBranch[]
  doctorProfile DoctorProfile?

  @@unique([tenantId, userId])
  @@index([userId])
}

model Role {
  id        String   @id @db.Uuid
  tenantId  String   @db.Uuid
  /// Stable key, e.g. "clinic_owner", "doctor". Custom roles use "custom_*".
  key       String
  /// Custom display name; system roles are translated from the message catalog.
  name      String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  members     MembershipRole[]

  @@unique([tenantId, key])
}

model RolePermission {
  tenantId   String @db.Uuid
  roleId     String @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([tenantId])
}

model MembershipRole {
  tenantId     String @db.Uuid
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([tenantId])
}

model MembershipBranch {
  tenantId     String @db.Uuid
  membershipId String @db.Uuid
  branchId     String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([tenantId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id                      String           @id @db.Uuid
  tenantId                String           @db.Uuid
  email                   String
  fullName                String
  roleKeys                String[]
  /// SHA-256 (hex) of the invitation token; the raw token is only in the emailed link.
  tokenHash               String           @unique
  status                  InvitationStatus @default(PENDING)
  expiresAt               DateTime
  invitedByPlatformUserId String?          @db.Uuid
  invitedByUserId         String?          @db.Uuid
  acceptedAt              DateTime?
  acceptedUserId          String?          @db.Uuid
  revokedAt               DateTime?
  sendCount               Int              @default(1)
  lastSentAt              DateTime         @default(now())
  createdAt               DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, email])
}

// ───────────────────────────── Support access (break-glass) ──────────────────

enum SupportAccessScope {
  /// Clinic settings, users, configuration. No patient data.
  CONFIGURATION
  /// Operational data (schedules, invoices) without clinical content.
  OPERATIONAL
  /// Read-only clinical access. Requires clinic-owner approval and is fully audited.
  CLINICAL_READ
}

enum SupportAccessStatus {
  REQUESTED
  APPROVED
  DENIED
  REVOKED
  EXPIRED
}

model SupportAccessGrant {
  id              String              @id @db.Uuid
  tenantId        String              @db.Uuid
  platformUserId  String              @db.Uuid
  /// Snapshot of who asked, so the clinic can see it without access to platform tables.
  requesterName   String              @default("")
  requesterEmail  String              @default("")
  scope           SupportAccessScope
  reason          String
  ticketRef       String?
  status          SupportAccessStatus @default(REQUESTED)
  durationMinutes Int
  requestedAt     DateTime            @default(now())
  decidedAt       DateTime?
  decidedByUserId String?             @db.Uuid
  startsAt        DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  platformUser PlatformUser @relation(fields: [platformUserId], references: [id])

  @@index([tenantId, status])
}

// ───────────────────────────── Audit ─────────────────────────────────────────

enum AuditActorType {
  PLATFORM_USER
  USER
  SYSTEM
  ANONYMOUS
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

/// Append-only, hash-chained audit trail. UPDATE/DELETE are rejected by a
/// trigger and `prevHash`/`hash` are computed by the database on insert.
/// `metadata` must never contain clinical content or secrets.
model AuditEvent {
  id         String         @id @db.Uuid
  seq        BigInt         @unique @default(autoincrement())
  tenantId   String?        @db.Uuid
  actorType  AuditActorType
  actorId    String?        @db.Uuid
  action     String
  entityType String?
  entityId   String?
  outcome    AuditOutcome   @default(SUCCESS)
  ipHash     String?
  userAgent  String?
  requestId  String?
  metadata   Json           @default("{}")
  prevHash   String?
  hash       String?
  createdAt  DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

// ───────────────────────────── Clinic resources & scheduling (Phase 5) ─────────

enum RoomKind {
  CONSULTATION
  PROCEDURE
  LABORATORY
  IMAGING
  WARD
  OTHER
}

model Room {
  id         String    @id @db.Uuid
  tenantId   String    @db.Uuid
  branchId   String    @db.Uuid
  name       String
  kind       RoomKind  @default(CONSULTATION)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  schedules WorkSchedule[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
}

enum ServiceKind {
  CONSULTATION
  PROCEDURE
  LAB_TEST
  IMAGING
  OTHER
}

/// Billable medical service. Prices are integer minor units (ISO 4217; UZS has 2).
/// Invoices (Phase 7) snapshot the price, so a later change never alters history.
model Service {
  id              String      @id @db.Uuid
  tenantId        String      @db.Uuid
  code            String
  name            String
  kind            ServiceKind @default(CONSULTATION)
  departmentId    String?     @db.Uuid
  durationMinutes Int         @default(20)
  priceMinor      BigInt
  currency        String      @default("UZS")
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  doctors    DoctorService[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Practitioner details for a clinic member who holds a doctor role.
model DoctorProfile {
  id                   String    @id @db.Uuid
  tenantId             String    @db.Uuid
  membershipId         String    @unique @db.Uuid
  /// Key from src/server/scheduling/specialties.ts (translated in the UI).
  specialty            String
  departmentId         String?   @db.Uuid
  licenseNumber        String?
  defaultSlotMinutes   Int       @default(20)
  acceptsOnlineBooking Boolean   @default(false)
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership Membership          @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  department Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schedules  WorkSchedule[]
  exceptions ScheduleException[]
  services   DoctorService[]

  @@index([tenantId])
}

model DoctorService {
  tenantId        String @db.Uuid
  doctorProfileId String @db.Uuid
  serviceId       String @db.Uuid

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  doctor  DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([doctorProfileId, serviceId])
  @@index([tenantId])
}

/// Recurring weekly working hours in the clinic local time zone.
/// weekday: 1 = Monday ... 7 = Sunday (ISO 8601). Minutes since local midnight.
model WorkSchedule {
  id              String   @id @db.Uuid
  tenantId        String   @db.Uuid
  doctorProfileId String   @db.Uuid
  branchId        String   @db.Uuid
  roomId          String?  @db.Uuid
  weekday         Int
  startMinute     Int
  endMinute       Int
  createdAt       DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  doctor DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  room   Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([tenantId, doctorProfileId, weekday])
}

/// A date on which the weekly schedule does not apply. The reason is a category
/// only, never free text: staff health information is sensitive.
enum ScheduleExceptionKind {
  DAY_OFF
  VACATION
  TRAINING
  OTHER_ABSENCE
}

model ScheduleException {
  id              String                @id @db.Uuid
  tenantId        String                @db.Uuid
  doctorProfileId String                @db.Uuid
  /// Local calendar date in the clinic time zone.
  date            DateTime              @db.Date
  kind            ScheduleExceptionKind
  createdAt       DateTime              @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  doctor DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@unique([doctorProfileId, date])
  @@index([tenantId, date])
}
